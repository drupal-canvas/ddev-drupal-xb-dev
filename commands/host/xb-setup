#!/bin/bash

## #ddev-generated
## Description: Set up the Canvas development environment.
## Usage: xb-setup
## Example: ddev xb-setup\nddev xb-setup --force
## Flags: [{"Name":"force","Shorthand":"f","Usage":"Completely reset an existing environment if present and start over"}]
## ExecRaw: true

cd "$(dirname "$0")" || exit
cd ../../../
set -e

resolve_canvas_dir() {
  ddev exec -- php -r '
$composer = json_decode((string) file_get_contents("composer.json"), true);
$paths = $composer["extra"]["installer-paths"] ?? [];
foreach ($paths as $path => $conditions) {
  if (in_array("type:drupal-module", $conditions, true)) {
    echo str_replace("{\$name}", "canvas", $path);
    exit(0);
  }
}
echo "modules/contrib/canvas";
'
}

CANVAS_DIR="$(resolve_canvas_dir)"
DOCROOT_PREFIX="${CANVAS_DIR%/modules/contrib/canvas}"
if [ "$DOCROOT_PREFIX" = "$CANVAS_DIR" ]; then
  DOCROOT_PREFIX=""
fi
SETTINGS_DDEV_PATH="${DOCROOT_PREFIX:+$DOCROOT_PREFIX/}sites/default/settings.ddev.php"
CORE_DIR_IN_CONTAINER="/var/www/html/${DOCROOT_PREFIX:+$DOCROOT_PREFIX/}core"

# Flag-handling.
while :; do
  case ${1:-} in
    -f | --force)
      FORCE=true ;;
    --)
      shift
      break ;;
    -?*)
      printf 'WARN: Unknown option (ignored): %s\n' "$1" >&2 ;;
    *) # Default case: No more options, so break out of the loop.
      break ;;
  esac
  shift
done

# Exit early if the environment is already set up.
if [ -d "$CANVAS_DIR/.git" ] && [ ! "$FORCE" ]; then
  GREEN="\033[0;32m"
  NO_COLOR="\033[0m"
  printf "%bThe Drupal Canvas development environment is already set up.%b\n" "$GREEN" "$NO_COLOR"
  # shellcheck disable=SC2016
  echo 'Note: If the environment is broken, run `ddev xb-setup --force` to completely reset it and start over.'
  echo 'Warning: If you do this, you will lose any changes you have made to the Drupal Canvas module or your Drupal site. Back up anything you want to save.'
  echo Hint: ddev xb-setup --force
  exit
fi

# Remove the Drupal Canvas module if it's there.
rm -rf "$CANVAS_DIR"
mkdir -p "$(dirname "$CANVAS_DIR")"

# Place the Drupal Canvas module via Git for development. Require
# it with Composer to test its composer.json and place dependencies.
git clone \
  git@git.drupal.org:project/canvas.git \
  "$CANVAS_DIR"

# Allow all Composer plugins.
ddev composer config \
  --no-plugins \
  allow-plugins.\* \
  true

# Require Drush, but don't install yet for performance reasons.
ddev composer require \
  --no-install \
  --update-with-all-dependencies \
  --no-interaction \
  drush/drush

# Require the Drupal Canvas module. Still don't install.
ddev composer config \
  repositories.xb \
  path \
  "$CANVAS_DIR"
ddev composer require \
  --no-install \
  --update-with-all-dependencies \
  --no-interaction \
  drupal/canvas

# Require dev dependencies. NOW install.
ddev composer require \
  --dev \
  --update-with-all-dependencies \
  --no-interaction \
  devizzent/cebe-php-openapi:^1.1.4 \
  drupal/metatag:^2. \
  jangregor/phpstan-prophecy:^2.2.0 \
  league/openapi-psr7-validator:^0.22.0 \
  webflo/drupal-finder:^1.3.1

# Allow test modules and themes to be installed.
# shellcheck disable=SC2016
printf '\n# Allow test modules and themes to be installed.\n$settings["extension_discovery_scan_tests"] = TRUE;' \
  >> "$SETTINGS_DDEV_PATH"

# Install Drupal and enable the Drupal Canvas module.
ddev xb-site-install

# Install Drupal core NPM packages.
ddev exec --dir "$CORE_DIR_IN_CONTAINER" -- npm install

# Build front-end assets.
ddev xb-ui-build

# Install DDEV Selenium Standalone Chrome
ddev add-on get ddev/ddev-selenium-standalone-chrome
